  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  }
}
