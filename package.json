{
  "name": "outcome-as-a-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
