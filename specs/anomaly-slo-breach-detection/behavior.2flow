validate_tenant_scope -(valid)-> validate_detection_configuration
validate_tenant_scope -(invalid)-> reject_scope_without_side_effect
validate_detection_configuration -(valid)-> validate_and_partition_metric_samples
validate_detection_configuration -(invalid)-> reject_configuration
validate_and_partition_metric_samples -(valid)-> calculate_historical_median_and_mad
validate_and_partition_metric_samples -(cross_tenant_or_invalid)-> reject_metric_input
calculate_historical_median_and_mad -(enough_baseline)-> evaluate_current_metric_deviations
calculate_historical_median_and_mad -(insufficient_baseline)-> record_insufficient_baseline
evaluate_current_metric_deviations -(outlier)-> emit_deterministic_metric_finding
evaluate_current_metric_deviations -(normal)-> continue_detection
record_insufficient_baseline -(complete)-> continue_detection
emit_deterministic_metric_finding -(complete)-> continue_detection
continue_detection -(valid_execution_window)-> calculate_execution_failure_rate
continue_detection -(invalid_execution_data)-> reject_execution_input
calculate_execution_failure_rate -(threshold_breached)-> emit_failure_rate_finding
calculate_execution_failure_rate -(below_threshold_or_insufficient)-> continue_to_slo_results
emit_failure_rate_finding -(complete)-> continue_to_slo_results
continue_to_slo_results -(slo_breached)-> emit_critical_slo_findings
continue_to_slo_results -(healthy_or_insufficient)-> deduplicate_and_sort_findings
emit_critical_slo_findings -(complete)-> deduplicate_and_sort_findings
deduplicate_and_sort_findings -(complete)-> return_immutable_detection_result
