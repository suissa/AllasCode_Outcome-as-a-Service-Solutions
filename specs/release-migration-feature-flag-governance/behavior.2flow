validate_release_manifest -(valid)-> validate_migration_and_rollback_plans
validate_release_manifest -(invalid)-> reject_release_candidate
validate_migration_and_rollback_plans -(valid)-> verify_all_release_gates
validate_migration_and_rollback_plans -(invalid)-> reject_missing_recovery_strategy
verify_all_release_gates -(all_pass)-> request_independent_approval
verify_all_release_gates -(any_failed)-> block_release
request_independent_approval -(independent)-> approve_release
request_independent_approval -(self_approval)-> reject_approval
approve_release -(approved)-> start_ordered_migrations
start_ordered_migrations -(checksum_and_order_match)-> record_migration_revision
start_ordered_migrations -(failure_or_drift)-> mark_failed_and_block_rollout
record_migration_revision -(all_complete)-> begin_progressive_rollout
record_migration_revision -(remaining)-> continue_ordered_migrations
begin_progressive_rollout -(health_passed)-> advance_monotonic_percentage
begin_progressive_rollout -(health_failed)-> halt_and_rollback
advance_monotonic_percentage -(one_hundred_percent)-> mark_deployed
advance_monotonic_percentage -(less_than_one_hundred)-> evaluate_next_health_gate
evaluate_next_health_gate -(pass)-> advance_monotonic_percentage
evaluate_next_health_gate -(fail)-> halt_and_rollback
halt_and_rollback -(independent_operator)-> execute_rollback_plan
halt_and_rollback -(invalid_operator)-> escalate_manual_recovery
execute_rollback_plan -(complete)-> mark_rolled_back
