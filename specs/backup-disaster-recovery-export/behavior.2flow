validate_backup_manifest -(valid)-> verify_backup_integrity
validate_backup_manifest -(invalid_or_expired)-> reject_backup
verify_backup_integrity -(matching_hash)-> assess_disaster_recovery_policy
verify_backup_integrity -(mismatch)-> reject_restore_and_export
assess_disaster_recovery_policy -(within_rpo_rto_and_replicated)-> report_ready
assess_disaster_recovery_policy -(missing_drill_or_replica)-> report_degraded
assess_disaster_recovery_policy -(missing_backup_or_rpo_breach)-> report_unavailable
authorize_restore -(authorized)-> verify_tenant_and_approval
authorize_restore -(denied)-> reject_restore
verify_tenant_and_approval -(valid)-> restore_to_staging
verify_tenant_and_approval -(cross_tenant_or_missing_approval)-> reject_restore
restore_to_staging -(staged)-> verify_staged_hash_and_scope
restore_to_staging -(provider_error)-> report_restore_failure
verify_staged_hash_and_scope -(valid)-> promote_to_target
verify_staged_hash_and_scope -(invalid)-> rollback_staging
promote_to_target -(success)-> return_restore_receipt
promote_to_target -(failure)-> rollback_staging
authorize_data_export -(authorized)-> enforce_classification_and_approval
authorize_data_export -(denied)-> reject_export
enforce_classification_and_approval -(valid)-> generate_export_artifact
enforce_classification_and_approval -(personal_data_unapproved)-> reject_export
generate_export_artifact -(generated)-> verify_tenant_expiry_and_hash
verify_tenant_expiry_and_hash -(valid)-> return_export_receipt
verify_tenant_expiry_and_hash -(invalid)-> reject_export_artifact
