validate_feedback_envelope -(valid)-> authorize_feedback_submission
validate_feedback_envelope -(invalid)-> reject_feedback
authorize_feedback_submission -(allowed)-> redact_sensitive_comment_fields
authorize_feedback_submission -(denied)-> reject_unauthorized_feedback
redact_sensitive_comment_fields -(clean)-> persist_idempotent_feedback
persist_idempotent_feedback -(stored_or_replayed)-> return_feedback_receipt
aggregate_feedback -(valid_window_and_tenant)-> calculate_rating_and_category_trends
aggregate_feedback -(invalid_or_cross_tenant)-> reject_aggregation
validate_incident_transition -(valid)-> authorize_incident_actor
validate_incident_transition -(invalid)-> reject_transition
authorize_incident_actor -(allowed)-> check_revision_and_state_graph
authorize_incident_actor -(denied)-> reject_without_mutation
check_revision_and_state_graph -(valid)-> require_transition_evidence
check_revision_and_state_graph -(stale_or_invalid)-> reject_transition
require_transition_evidence -(resolved)-> verify_resolution_summary_and_evidence
require_transition_evidence -(other_state)-> commit_cas_transition_and_audit
verify_resolution_summary_and_evidence -(valid)-> commit_cas_transition_and_audit
verify_resolution_summary_and_evidence -(missing)-> reject_resolution
commit_cas_transition_and_audit -(committed)-> return_incident_state
commit_cas_transition_and_audit -(conflict)-> reject_revision_conflict
create_postmortem -(resolved_incident)-> authorize_preparer_and_independent_reviewer
create_postmortem -(unresolved_incident)-> reject_postmortem
authorize_preparer_and_independent_reviewer -(allowed)-> verify_all_evidence
authorize_preparer_and_independent_reviewer -(denied_or_self_review)-> reject_postmortem
verify_all_evidence -(verified)-> validate_owned_action_items_and_hash_snapshot
verify_all_evidence -(missing_or_invalid)-> reject_postmortem
validate_owned_action_items_and_hash_snapshot -(complete)-> return_immutable_postmortem
