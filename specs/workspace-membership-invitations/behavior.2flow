validate_invitation_request -(valid)-> authorize_workspace_manager
validate_invitation_request -(invalid)-> reject_invitation
authorize_workspace_manager -(allowed)-> normalize_recipient_and_hash_token
authorize_workspace_manager -(denied)-> reject_without_side_effect
normalize_recipient_and_hash_token -(unique_pending_recipient)-> atomically_store_pending_invitation
normalize_recipient_and_hash_token -(duplicate_pending)-> reject_duplicate_invitation
atomically_store_pending_invitation -(stored)-> deliver_email_with_raw_token
deliver_email_with_raw_token -(delivered)-> return_metadata_only
deliver_email_with_raw_token -(failed)-> revoke_pending_invitation_and_escalate
accept_invitation -(token_found)-> validate_scope_expiry_and_status
accept_invitation -(token_missing)-> reject_not_found
validate_scope_expiry_and_status -(valid)-> verify_recipient_identity
validate_scope_expiry_and_status -(invalid)-> reject_acceptance
verify_recipient_identity -(verified)-> atomically_accept_and_create_membership
verify_recipient_identity -(mismatch)-> reject_acceptance
atomically_accept_and_create_membership -(committed)-> return_active_membership
atomically_accept_and_create_membership -(conflict)-> reject_replay
revoke_membership -(authorized)-> verify_owner_invariant
revoke_membership -(denied)-> reject_revocation
verify_owner_invariant -(another_active_owner)-> commit_revocation_with_audit
verify_owner_invariant -(last_owner)-> reject_and_preserve_owner
