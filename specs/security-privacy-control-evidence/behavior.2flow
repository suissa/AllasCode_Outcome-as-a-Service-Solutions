validate_compliance_run_scope -(valid)-> authorize_control_runner
validate_compliance_run_scope -(invalid)-> reject_run_input
authorize_control_runner -(allowed)-> validate_control_definitions
authorize_control_runner -(denied)-> reject_without_side_effect
validate_control_definitions -(valid)-> validate_tenant_evidence_provenance
validate_control_definitions -(invalid)-> reject_control_configuration
validate_tenant_evidence_provenance -(valid)-> verify_hash_privacy_basis_and_period
validate_tenant_evidence_provenance -(cross_tenant_or_unknown_control)-> reject_evidence
verify_hash_privacy_basis_and_period -(valid)-> evaluate_required_evidence_coverage_and_freshness
verify_hash_privacy_basis_and_period -(invalid)-> reject_evidence_without_mutation
evaluate_required_evidence_coverage_and_freshness -(all_pass)-> emit_passed_control_result
evaluate_required_evidence_coverage_and_freshness -(failed_check_or_expired)-> emit_failed_control_result
evaluate_required_evidence_coverage_and_freshness -(missing_or_stale)-> emit_not_evidenced_control_result
emit_passed_control_result -(complete)-> compile_immutable_compliance_run
emit_failed_control_result -(complete)-> compile_immutable_compliance_run
emit_not_evidenced_control_result -(complete)-> compile_immutable_compliance_run
compile_immutable_compliance_run -(valid)-> hash_evidence_bundle
hash_evidence_bundle -(prepared)-> require_independent_review
require_independent_review -(independent)-> verify_snapshot_hash_and_record_review
require_independent_review -(self_review)-> reject_review
verify_snapshot_hash_and_record_review -(valid)-> return_reviewed_bundle
verify_snapshot_hash_and_record_review -(tampered)-> reject_bundle_integrity
