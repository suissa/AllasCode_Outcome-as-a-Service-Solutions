validate_rotation_command -(valid)-> authorize_rotation_actor
validate_rotation_command -(invalid)-> reject_rotation_input
authorize_rotation_actor -(allowed)-> resolve_tenant_credential
authorize_rotation_actor -(denied)-> reject_unauthorized_without_mutation
resolve_tenant_credential -(found)-> verify_expected_revision_and_due_policy
resolve_tenant_credential -(missing_or_cross_tenant)-> reject_credential_not_found
verify_expected_revision_and_due_policy -(valid)-> request_idempotent_vault_rotation
verify_expected_revision_and_due_policy -(stale_or_not_due)-> reject_without_vault_call
request_idempotent_vault_rotation -(valid_metadata)-> atomically_commit_new_reference_and_audit
request_idempotent_vault_rotation -(invalid_or_failed)-> preserve_existing_credential_state
atomically_commit_new_reference_and_audit -(committed)-> return_metadata_only
atomically_commit_new_reference_and_audit -(cas_conflict)-> return_revision_conflict_and_allow_idempotent_retry
validate_access_review -(valid)-> authorize_independent_reviewer
validate_access_review -(invalid)-> reject_review_input
authorize_independent_reviewer -(allowed)-> resolve_tenant_access_grant
authorize_independent_reviewer -(denied_or_self_review)-> reject_review_without_mutation
resolve_tenant_access_grant -(found)-> validate_grant_scope_and_revision
resolve_tenant_access_grant -(missing_or_cross_tenant)-> reject_grant_not_found
validate_grant_scope_and_revision -(retain)-> commit_retain_review_with_audit
validate_grant_scope_and_revision -(revoke)-> clear_permissions_and_commit_revocation
commit_retain_review_with_audit -(committed)-> return_review_decision
clear_permissions_and_commit_revocation -(committed)-> return_revoked_grant
