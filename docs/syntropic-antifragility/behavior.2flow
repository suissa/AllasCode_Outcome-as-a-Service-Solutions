capture_disruption -(validate_required_fields_and_timestamp)-> verify_evidence_scope
verify_evidence_scope -(reject_cross_tenant_or_missing_evidence)-> quarantine_invalid_disruption
verify_evidence_scope -(evidence_valid)-> persist_disruption_reference
persist_disruption_reference -(append_evidence_event)-> review_root_cause
review_root_cause -(hypothesis_reviewed)-> propose_structural_change
propose_structural_change -(version_controls_and_regression_tests)-> classify_formal_obligations
classify_formal_obligations -(proof_required)-> verify_formal_properties
classify_formal_obligations -(proof_not_required_with_reason)-> run_regression_and_chaos_tests
verify_formal_properties -(proof_failed_or_missing)-> reject_proposal
verify_formal_properties -(proof_passed)-> run_regression_and_chaos_tests
run_regression_and_chaos_tests -(tests_failed)-> reject_proposal
run_regression_and_chaos_tests -(tests_passed)-> assess_policy_and_release_gates
assess_policy_and_release_gates -(policy_or_rollback_or_blast_radius_invalid)-> reject_proposal
assess_policy_and_release_gates -(human_approval_required)-> request_human_approval
request_human_approval -(approval_denied_or_expired)-> reject_proposal
request_human_approval -(approval_granted)-> promote_approved_change
assess_policy_and_release_gates -(all_gates_passed_and_no_human_gate)-> promote_approved_change
promote_approved_change -(release_governance_handoff)-> monitor_post_change_effect
monitor_post_change_effect -(guardrail_regression)-> rollback_regression
monitor_post_change_effect -(measured_improvement)-> consolidate_verified_learning
monitor_post_change_effect -(no_material_improvement)-> retain_evidence_without_antifragile_claim
rollback_regression -(rollback_verified)-> record_regression_and_reopen_root_cause
rollback_regression -(rollback_failed)-> escalate_incident
consolidate_verified_learning -(publish_versioned_learning)-> detect_recurrence
